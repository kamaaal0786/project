# Copy this file to .env and fill in your values
DATABASE_URL=postgresql://postgres:password@localhost:5432/credit_dropout_db
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ML (Phase 2)
MODEL_PATH=../ml/model/dropout_model.joblib

# Intervention thresholds (Phase 3) — centralized here, never in React
ATTENDANCE_THRESHOLD=75.0
FAILED_SUBJECTS_THRESHOLD=2
CREDIT_DEFICIT_THRESHOLD=10.0
ASSIGNMENT_COMPLETION_THRESHOLD=60.0

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
